# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/t4t-ca

# personal github repos (rv32ima/*) still use the 1p key,, git rewrites to this alias via
# url.insteadOf. everything else (fleet + t4t-net on github) uses the step cert in $SSH_AUTH_SOCK
Host github-personal
  HostName github.com
  User git
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  
Host artpop
  User ellie
  ForwardAgent yes

Host sw1.sea.t4t.net
  PubkeyAcceptedAlgorithms +ssh-rsa

Host cofractal-oob
  User root
  HostName 2605:bb00:c510::210

Host oob-forwarded
  User root
  HostName localhost
  Port 2223
